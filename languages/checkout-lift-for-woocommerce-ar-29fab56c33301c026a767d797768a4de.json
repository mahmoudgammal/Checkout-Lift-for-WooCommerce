            ],
            "Clears every field customisation and returns the checkout to the WooCommerce defaults. Multi-step, autocomplete, and recovery settings are left alone.": [
                "\u064a\u0645\u0633\u062d \u0643\u0644 \u062a\u062e\u0635\u064a\u0635\u0627\u062a \u0627\u0644\u062d\u0642\u0648\u0644 \u0648\u064a\u0639\u064a\u062f \u0635\u0641\u062d\u0629 \u0625\u062a\u0645\u0627\u0645 \u0627\u0644\u0637\u0644\u0628 \u0625\u0644\u0649 \u0625\u0639\u062f\u0627\u062f\u0627\u062a WooCommerce \u0627\u0644\u0627\u0641\u062a\u0631\u0627\u0636\u064a\u0629. \u0625\u0639\u062f\u0627\u062f\u0627\u062a \u0627\u0644\u062e\u0637\u0648\u0627\u062a \u0627\u0644\u0645\u062a\u0639\u062f\u062f\u0629 \u0648\u0627\u0644\u0625\u0643\u0645\u0627\u0644 \u0627\u0644\u062a\u0644\u0642\u0627\u0626\u064a \u0648\u0627\u0644\u0627\u0633\u062a\u0631\u062f\u0627\u062f \u0644\u0627 \u062a\u062a\u0623\u062b\u0631."
            ],
            "This clears every checkout field customisation and returns to the WooCommerce defaults. Continue?": [
                "\u0633\u064a\u0624\u062f\u064a \u0647\u0630\u0627 \u0625\u0644\u0649 \u0645\u0633\u062d \u0643\u0644 \u062a\u062e\u0635\u064a\u0635\u0627\u062a \u062d\u0642\u0648\u0644 \u0625\u062a\u0645\u0627\u0645 \u0627\u0644\u0637\u0644\u0628 \u0648\u0627\u0644\u0631\u062c\u0648\u0639 \u0625\u0644\u0649 \u0625\u0639\u062f\u0627\u062f\u0627\u062a WooCommerce \u0627\u0644\u0627\u0641\u062a\u0631\u0627\u0636\u064a\u0629. \u0647\u0644 \u062a\u0631\u064a\u062f \u0627\u0644\u0645\u062a\u0627\u0628\u0639\u0629\u061f"
            ],
            "Reset. Reloading\u2026": [
                "\u062a\u0645\u062a \u0625\u0639\u0627\u062f\u0629 \u0627\u0644\u0636\u0628\u0637. \u062c\u0627\u0631\u064d \u0625\u0639\u0627\u062f\u0629 \u0627\u0644\u062a\u062d\u0645\u064a\u0644\u2026"
            ],
            "Reset checkout fields": [
                "\u0625\u0639\u0627\u062f\u0629 \u0636\u0628\u0637 \u062d\u0642\u0648\u0644 \u0625\u062a\u0645\u0627\u0645 \u0627\u0644\u0637\u0644\u0628"
            ],
            "Reload now": [
                "\u0625\u0639\u0627\u062f\u0629 \u0627\u0644\u062a\u062d\u0645\u064a\u0644 \u0627\u0644\u0622\u0646"
            ],
            "required": [
                "\u0645\u0637\u0644\u0648\u0628"
            ],
            "hidden": [
                "\u0645\u062e\u0641\u064a"
            ],
            "conditional": [
                "\u0645\u0634\u0631\u0648\u0637"
            ],
            "Move up": [
                "\u062a\u062d\u0631\u064a\u0643 \u0644\u0623\u0639\u0644\u0649"
            ],
            "Move down": [
                "\u062a\u062d\u0631\u064a\u0643 \u0644\u0623\u0633\u0641\u0644"
            ],
            "Width (%)": [
                "\u0627\u0644\u0639\u0631\u0636 (%)"
            ],
            "Show on the checkout": [
                "\u0625\u0638\u0647\u0627\u0631 \u0641\u064a \u0635\u0641\u062d\u0629 \u0625\u062a\u0645\u0627\u0645 \u0627\u0644\u0637\u0644\u0628"
            ],
            "Type, rules and conditions": [
                "\u0627\u0644\u0646\u0648\u0639 \u0648\u0627\u0644\u0642\u0648\u0627\u0639\u062f \u0648\u0627\u0644\u0634\u0631\u0648\u0637"
            ],
            "Remove this field?": [
                "\u062d\u0630\u0641 \u0647\u0630\u0627 \u0627\u0644\u062d\u0642\u0644\u061f"
            ],
            "Remove this field": [
                "\u062d\u0630\u0641 \u0647\u0630\u0627 \u0627\u0644\u062d\u0642\u0644"
            ],
            "Choose a field to edit it.": [
                "\u0627\u062e\u062a\u0631 \u062d\u0642\u0644\u064b\u0627 \u0644\u062a\u0639\u062f\u064a\u0644\u0647."
            ],
            "Fields saved.": [
                "\u062a\u0645 \u062d\u0641\u0638 \u0627\u0644\u062d\u0642\u0648\u0644."
            ],
            "Save fields": [
                "\u062d\u0641\u0638 \u0627\u0644\u062d\u0642\u0648\u0644"
            ],
            "Unsaved changes": [
                "\u062a\u063a\u064a\u064a\u0631\u0627\u062a \u063a\u064a\u0631 \u0645\u062d\u0641\u0648\u0638\u0629"
            ],
            "All changes saved": [
                "\u062a\u0645 \u062d\u0641\u0638 \u0643\u0644 \u0627\u0644\u062a\u063a\u064a\u064a\u0631\u0627\u062a"
            ],
            "Decide what your checkout asks for, and when it asks for it.": [
                "\u062d\u062f\u062f \u0645\u0627 \u062a\u0637\u0644\u0628\u0647 \u0635\u0641\u062d\u0629 \u0625\u062a\u0645\u0627\u0645 \u0627\u0644\u0637\u0644\u0628 \u0645\u0646 \u0627\u0644\u0639\u0645\u064a\u0644\u060c \u0648\u0645\u062a\u0649 \u062a\u0637\u0644\u0628\u0647."
            ],
            "Fields": [
                "\u0627\u0644\u062d\u0642\u0648\u0644"
            ],
            "Tools": [
                "\u0627\u0644\u0623\u062f\u0648\u0627\u062a"
            ],
            "What this plugin does": [
                "\u0645\u0627 \u0627\u0644\u0630\u064a \u062a\u0642\u0648\u0645 \u0628\u0647 \u0647\u0630\u0647 \u0627\u0644\u0625\u0636\u0627\u0641\u0629"
            ],
            "Switching a part off stops it loading at all, on the checkout and in the admin. Nothing you have configured is deleted, so switching it back on restores it.": [
                "\u0625\u064a\u0642\u0627\u0641 \u0623\u064a \u062c\u0632\u0621 \u064a\u0645\u0646\u0639 \u062a\u062d\u0645\u064a\u0644\u0647 \u062a\u0645\u0627\u0645\u064b\u0627\u060c \u0641\u064a \u0635\u0641\u062d\u0629 \u0625\u062a\u0645\u0627\u0645 \u0627\u0644\u0637\u0644\u0628 \u0648\u0641\u064a \u0644\u0648\u062d\u0629 \u0627\u0644\u062a\u062d\u0643\u0645. \u0644\u0627 \u064a\u064f\u062d\u0630\u0641 \u0623\u064a \u0634\u064a\u0621 \u0642\u0645\u062a \u0628\u0625\u0639\u062f\u0627\u062f\u0647\u060c \u0644\u0630\u0627 \u062a\u0634\u063a\u064a\u0644\u0647 \u0645\u0631\u0629 \u0623\u062e\u0631\u0649 \u064a\u0639\u064a\u062f\u0647 \u0643\u0645\u0627 \u0643\u0627\u0646."
            ],
            "Saved. Reload any open screen to see the change.": [
                "\u062a\u0645 \u0627\u0644\u062d\u0641\u0638. \u0623\u0639\u062f \u062a\u062d\u0645\u064a\u0644 \u0623\u064a \u0634\u0627\u0634\u0629 \u0645\u0641\u062a\u0648\u062d\u0629 \u0644\u062a\u0631\u0649 \u0627\u0644\u062a\u063a\u064a\u064a\u0631."
            ],
            "Save": [
                "\u062d\u0641\u0638"
            ],
            "Recording": [
                "\u0627\u0644\u062a\u0633\u062c\u064a\u0644"
            ],
            "Record checkout activity": [
                "\u062a\u0633\u062c\u064a\u0644 \u0646\u0634\u0627\u0637 \u0625\u062a\u0645\u0627\u0645 \u0627\u0644\u0637\u0644\u0628"
            ],
            "Stores what customers enter at checkout so unfinished orders can be recovered.": [
                "\u064a\u062d\u0641\u0638 \u0645\u0627 \u064a\u0643\u062a\u0628\u0647 \u0627\u0644\u0639\u0645\u0644\u0627\u0621 \u0641\u064a \u0635\u0641\u062d\u0629 \u0625\u062a\u0645\u0627\u0645 \u0627\u0644\u0637\u0644\u0628 \u062d\u062a\u0649 \u064a\u0645\u0643\u0646 \u0627\u0633\u062a\u0631\u062f\u0627\u062f \u0627\u0644\u0637\u0644\u0628\u0627\u062a \u063a\u064a\u0631 \u0627\u0644\u0645\u0643\u062a\u0645\u0644\u0629."
            ],
            "Ask the customer for permission first": [
                "\u0627\u0637\u0644\u0628 \u0645\u0648\u0627\u0641\u0642\u0629 \u0627\u0644\u0639\u0645\u064a\u0644 \u0623\u0648\u0644\u064b\u0627"
            ],
            "Nothing is stored unless the customer agrees. Required in the EU and UK. Only turn this off if you are certain your local law allows it.": [
                "\u0644\u0627 \u064a\u064f\u062d\u0641\u0638 \u0623\u064a \u0634\u064a\u0621 \u0625\u0644\u0627 \u0628\u0645\u0648\u0627\u0641\u0642\u0629 \u0627\u0644\u0639\u0645\u064a\u0644. \u0647\u0630\u0627 \u0645\u0637\u0644\u0648\u0628 \u0641\u064a \u0627\u0644\u0627\u062a\u062d\u0627\u062f \u0627\u0644\u0623\u0648\u0631\u0648\u0628\u064a \u0648\u0627\u0644\u0645\u0645\u0644\u0643\u0629 \u0627\u0644\u0645\u062a\u062d\u062f\u0629. \u0644\u0627 \u062a\u0648\u0642\u0641\u0647 \u0625\u0644\u0627 \u0625\u0630\u0627 \u0643\u0646\u062a \u0645\u062a\u0623\u0643\u062f\u064b\u0627 \u0623\u0646 \u0627\u0644\u0642\u0627\u0646\u0648\u0646 \u0627\u0644\u0645\u062d\u0644\u064a \u0644\u062f\u064a\u0643 \u064a\u0633\u0645\u062d \u0628\u0630\u0644\u0643."
            ],
            "Permission wording shown at checkout": [
                "\u0646\u0635 \u0637\u0644\u0628 \u0627\u0644\u0645\u0648\u0627\u0641\u0642\u0629 \u0641\u064a \u0635\u0641\u062d\u0629 \u0625\u062a\u0645\u0627\u0645 \u0627\u0644\u0637\u0644\u0628"
            ],
            "Timing": [
                "\u0627\u0644\u062a\u0648\u0642\u064a\u062a"
            ],
            "Treat a checkout as abandoned after": [
                "\u0627\u0639\u062a\u0628\u0627\u0631 \u0625\u062a\u0645\u0627\u0645 \u0627\u0644\u0637\u0644\u0628 \u0645\u062a\u0631\u0648\u0643\u064b\u0627 \u0628\u0639\u062f"
            ],
            "Minutes of no activity.": [
                "\u062f\u0642\u0627\u0626\u0642 \u0628\u062f\u0648\u0646 \u0623\u064a \u0646\u0634\u0627\u0637."
            ],
            "Recovery email": [
                "\u0631\u0633\u0627\u0644\u0629 \u0627\u0644\u0627\u0633\u062a\u0631\u062f\u0627\u062f"
            ],
            "Optional subject override for email 1": [
                "\u0639\u0646\u0648\u0627\u0646 \u0628\u062f\u064a\u0644 \u0627\u062e\u062a\u064a\u0627\u0631\u064a \u0644\u0644\u0631\u0633\u0627\u0644\u0629 1"
            ],
            "Optional email subject": [
                "\u0639\u0646\u0648\u0627\u0646 \u0627\u0644\u0631\u0633\u0627\u0644\u0629 (\u0627\u062e\u062a\u064a\u0627\u0631\u064a)"
            ],
            "Optional message added to email 1": [
                "\u0646\u0635 \u0627\u062e\u062a\u064a\u0627\u0631\u064a \u064a\u064f\u0636\u0627\u0641 \u0625\u0644\u0649 \u0627\u0644\u0631\u0633\u0627\u0644\u0629 1"
            ],
            "Email message": [
                "\u0646\u0635 \u0627\u0644\u0631\u0633\u0627\u0644\u0629"
            ],
            "Use {name} for the customer, {link} for the button back to their checkout, and {site} for your store name.": [
                "\u0627\u0633\u062a\u062e\u062f\u0645 {name} \u0644\u0627\u0633\u0645 \u0627\u0644\u0639\u0645\u064a\u0644\u060c \u0648{link} \u0644\u0632\u0631 \u0627\u0644\u0639\u0648\u062f\u0629 \u0625\u0644\u0649 \u0635\u0641\u062d\u0629 \u0625\u062a\u0645\u0627\u0645 \u0627\u0644\u0637\u0644\u0628\u060c \u0648{site} \u0644\u0627\u0633\u0645 \u0645\u062a\u062c\u0631\u0643."
            ],
            "Recover abandoned checkout value automatically": [
                "\u0627\u0633\u062a\u0631\u062f \u0642\u064a\u0645\u0629 \u0639\u0645\u0644\u064a\u0627\u062a \u0625\u062a\u0645\u0627\u0645 \u0627\u0644\u0637\u0644\u0628 \u0627\u0644\u0645\u062a\u0631\u0648\u0643\u0629 \u062a\u0644\u0642\u0627\u0626\u064a\u064b\u0627"
            ],
            "Lite records abandoned checkouts and their potential value. Pro sends a four-email sequence and restores the saved cart through a secure link.": [
                "\u0627\u0644\u0646\u0633\u062e\u0629 \u0627\u0644\u0645\u062c\u0627\u0646\u064a\u0629 \u062a\u0633\u062c\u0644 \u0639\u0645\u0644\u064a\u0627\u062a \u0625\u062a\u0645\u0627\u0645 \u0627\u0644\u0637\u0644\u0628 \u0627\u0644\u0645\u062a\u0631\u0648\u0643\u0629 \u0648\u0642\u064a\u0645\u062a\u0647\u0627 \u0627\u0644\u0645\u062d\u062a\u0645\u0644\u0629. \u0646\u0633\u062e\u0629 Pro \u062a\u0631\u0633\u0644 \u0633\u0644\u0633\u0644\u0629 \u0645\u0646 \u0623\u0631\u0628\u0639 \u0631\u0633\u0627\u0626\u0644 \u0648\u062a\u0633\u062a\u0639\u064a\u062f \u0627\u0644\u0633\u0644\u0629 \u0627\u0644\u0645\u062d\u0641\u0648\u0638\u0629 \u0639\u0628\u0631 \u0631\u0627\u0628\u0637 \u0622\u0645\u0646."
            ],
            "Explore Pro recovery": [
                "\u0627\u0643\u062a\u0634\u0641 \u0627\u0644\u0627\u0633\u062a\u0631\u062f\u0627\u062f \u0641\u064a Pro"
            ],
            "Data": [
                "\u0627\u0644\u0628\u064a\u0627\u0646\u0627\u062a"
            ],
            "Keep checkout activity for": [
                "\u0627\u0644\u0627\u062d\u062a\u0641\u0627\u0638 \u0628\u0646\u0634\u0627\u0637 \u0625\u062a\u0645\u0627\u0645 \u0627\u0644\u0637\u0644\u0628 \u0644\u0645\u062f\u0629"
            ],
            "Days, then delete it automatically.": [
                "\u064a\u0648\u0645\u060c \u062b\u0645 \u064a\u064f\u062d\u0630\u0641 \u062a\u0644\u0642\u0627\u0626\u064a\u064b\u0627."
            ],
            "Delete all plugin data when the plugin is deleted": [
                "\u062d\u0630\u0641 \u0643\u0644 \u0628\u064a\u0627\u0646\u0627\u062a \u0627\u0644\u0625\u0636\u0627\u0641\u0629 \u0639\u0646\u062f \u062d\u0630\u0641 \u0627\u0644\u0625\u0636\u0627\u0641\u0629"
            ],
            "Turn this off to keep your settings and stored activity if you remove the plugin.": [
                "\u0623\u0648\u0642\u0641 \u0647\u0630\u0627 \u0627\u0644\u062e\u064a\u0627\u0631 \u0644\u0644\u0627\u062d\u062a\u0641\u0627\u0638 \u0628\u0625\u0639\u062f\u0627\u062f\u0627\u062a\u0643 \u0648\u0627\u0644\u0646\u0634\u0627\u0637 \u0627\u0644\u0645\u062d\u0641\u0648\u0638 \u0625\u0630\u0627 \u062d\u0630\u0641\u062a \u0627\u0644\u0625\u0636\u0627\u0641\u0629."
            ],
            "Save settings": [
                "\u062d\u0641\u0638 \u0627\u0644\u0625\u0639\u062f\u0627\u062f\u0627\u062a"
            ],
            "Remove the shipping section entirely": [
                "\u0625\u0632\u0627\u0644\u0629 \u0642\u0633\u0645 \u0627\u0644\u0634\u062d\u0646 \u0628\u0627\u0644\u0643\u0627\u0645\u0644"
            ],
            "For stores that never ship anything. Shipping fields disappear from the checkout.": [
                "\u0644\u0644\u0645\u062a\u0627\u062c\u0631 \u0627\u0644\u062a\u064a \u0644\u0627 \u062a\u0634\u062d\u0646 \u0623\u064a \u0634\u064a\u0621. \u062d\u0642\u0648\u0644 \u0627\u0644\u0634\u062d\u0646 \u0633\u062a\u062e\u062a\u0641\u064a \u0645\u0646 \u0635\u0641\u062d\u0629 \u0625\u062a\u0645\u0627\u0645 \u0627\u0644\u0637\u0644\u0628."
            ],
            "General": [
                "\u0639\u0627\u0645"
            ],
            "Checkout": [
                "\u0625\u062a\u0645\u0627\u0645 \u0627\u0644\u0637\u0644\u0628"
            ],
            "Everything the plugin can do, and how each part behaves.": [
                "\u0643\u0644 \u0645\u0627 \u062a\u0633\u062a\u0637\u064a\u0639 \u0627\u0644\u0625\u0636\u0627\u0641\u0629 \u0641\u0639\u0644\u0647\u060c \u0648\u0643\u064a\u0641 \u064a\u0639\u0645\u0644 \u0643\u0644 \u062c\u0632\u0621."
            ],
            "Checkout attempts": [
                "\u0645\u062d\u0627\u0648\u0644\u0627\u062a \u0625\u062a\u0645\u0627\u0645 \u0627\u0644\u0637\u0644\u0628"
            ],
            "Orders placed": [
                "\u0627\u0644\u0637\u0644\u0628\u0627\u062a \u0627\u0644\u0645\u0643\u062a\u0645\u0644\u0629"
            ],
            "Abandoned attempts": [
                "\u0627\u0644\u0645\u062d\u0627\u0648\u0644\u0627\u062a \u0627\u0644\u0645\u062a\u0631\u0648\u0643\u0629"
            ],
            "Checkout funnel": [
                "\u0645\u0633\u0627\u0631 \u0625\u062a\u0645\u0627\u0645 \u0627\u0644\u0637\u0644\u0628"
            ],
            "Measure checkout outcomes and the potential value sitting in abandoned checkouts.": [
                "\u0642\u0650\u0633 \u0646\u062a\u0627\u0626\u062c \u0625\u062a\u0645\u0627\u0645 \u0627\u0644\u0637\u0644\u0628 \u0648\u0627\u0644\u0642\u064a\u0645\u0629 \u0627\u0644\u0645\u062d\u062a\u0645\u0644\u0629 \u0641\u064a \u0639\u0645\u0644\u064a\u0627\u062a \u0625\u062a\u0645\u0627\u0645 \u0627\u0644\u0637\u0644\u0628 \u0627\u0644\u0645\u062a\u0631\u0648\u0643\u0629."
            ],
            "Period": [
                "\u0627\u0644\u0641\u062a\u0631\u0629"
            ],
            "Last 7 days": [
                "\u0622\u062e\u0631 7 \u0623\u064a\u0627\u0645"
            ],
            "Last 30 days": [
                "\u0622\u062e\u0631 30 \u064a\u0648\u0645\u064b\u0627"
            ],
            "Checkout measurement is off. Enable recording in Recovery settings to collect new activity.": [
